# Leave empty in local Vite dev so requests use the `/api` Vite proxy -> http://127.0.0.1:8080.
# In production / Capacitor APK, set the full Rust API base URL (e.g. https://api.yourdomain.com).
VITE_API_URL=

# Optional OAuth2 client IDs for GitHub and Google sign-in buttons.
VITE_OAUTH_GITHUB_CLIENT_ID=
VITE_OAUTH_GOOGLE_CLIENT_ID=
