# Systemd unit for the Codexter Rust Axum backend.
# Copy to /etc/systemd/system/codexter-backend.service on the VPS.
[Unit]
Description=Codexter Rust Backend
After=network.target docker.service

[Service]
Type=simple
User=rallc
WorkingDirectory=/home/rallc/projects/codexinternational/backend
# Default to :8081 behind Caddy (:8080); VPS .env may still override BIND_ADDR explicitly.
Environment=BIND_ADDR=127.0.0.1:8081
EnvironmentFile=/home/rallc/projects/codexinternational/.env
ExecStart=/home/rallc/projects/codexinternational/backend/target/release/backend
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
