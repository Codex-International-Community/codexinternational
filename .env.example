# Application
APP_ENV=development
# Bind strictly to localhost (127.0.0.1) so local dev never exposes ports to LAN
BIND_ADDR=127.0.0.1:8080
RUST_LOG=info,backend=debug
WORKER_ROLES=ALL

# PostgreSQL
POSTGRES_USER=codex
POSTGRES_PASSWORD=codex_dev_password
POSTGRES_DB=codexinternational
POSTGRES_PORT=5432
DATABASE_URL=postgres://codex:codex_dev_password@127.0.0.1:5432/codexinternational

# Valkey 9.1
VALKEY_PORT=6379
VALKEY_URL=valkey://127.0.0.1:6379
MSG_FLUSH_INTERVAL_MS=250
COUNTER_FLUSH_INTERVAL_MS=500

# Auth & Security (WAJIB diisi kuat >= 32 char di production - INV-13)
JWT_SECRET=dev-only-jwt-secret-change-in-production
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_DAYS=30
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Email Outbound: Brevo SMTP Relay (send-as custom domain, SPF/DKIM)
# Inbound replies handled via Cloudflare Email Routing -> personal Gmail
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com
SMTP_REPLY_TO=support@yourdomain.com

# Cloudflare R2 (100% Object Storage - tanpa AWS S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=codex-media
R2_BACKUP_BUCKET_NAME=codex-backups
R2_PUBLIC_BASE_URL=

# AWS Lambda (Rust FFmpeg Video Compressor)
AWS_REGION=ap-southeast-1
AWS_LAMBDA_VIDEO_FN=codex-video-compressor
LAMBDA_WEBHOOK_SECRET=dev-only-lambda-hmac-secret-change-in-production

# Firebase Cloud Messaging (HTTP v1 Service Account)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=

# CORS & Frontend (Vite reads VITE_* from root .env via envDir: '..')
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_URL=
VITE_OAUTH_GITHUB_CLIENT_ID=
VITE_OAUTH_GOOGLE_CLIENT_ID=
